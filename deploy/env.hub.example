# Towpath instance settings (with compose.hub.example.yml). Everything else is set in the browser.
TOWPATH_IMAGE=ghcr.io/OWNER/towpath@sha256:REPLACE_WITH_PUBLISHED_DIGEST
TOWPATH_RECOLL_IMAGE=ghcr.io/OWNER/towpath-recoll@sha256:REPLACE_WITH_PUBLISHED_DIGEST
# The folder you created for Towpath, owned by TOWPATH_USER (on TrueNAS: a dataset).
TOWPATH_DATA_DIR=/path/to/towpath-data
# The address your reverse proxy serves Towpath at.
TOWPATH_PUBLIC_URL=https://towpath.example.org
# Your reverse proxy's Docker network (SWAG often uses "proxy").
TOWPATH_PROXY_NETWORK=proxy
# The user the containers run as. 568:568 is TrueNAS's "apps" user. Every app running as that user can read
# Towpath's stored passwords; a dedicated user (for example 10001:10001) keeps them private to Towpath.
TOWPATH_USER=568:568
