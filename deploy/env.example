# Copy to .env next to compose.yml in a private deployment folder (never commit it).
# Every value below is a placeholder.

# A published image pinned by digest (from the CI run's release record or the package page).
TOWPATH_IMAGE=ghcr.io/OWNER/towpath-recoll@sha256:REPLACE_WITH_PUBLISHED_DIGEST

# Read-only: the folder to search.
TOWPATH_SOURCE_DIR=/path/to/archive
# Read-only: holds towpath.toml (start from towpath.toml.example).
TOWPATH_CONFIG_DIR=/path/to/towpath/config
# Writable by uid 10001, on disk: Recoll index (holds recoll/recoll.conf), Towpath state,
# recovered copies, and scratch space.
TOWPATH_INDEX_DIR=/path/to/towpath/index
TOWPATH_STATE_DIR=/path/to/towpath/state
TOWPATH_RECOVERED_DIR=/path/to/towpath/recovered
TOWPATH_SCRATCH_DIR=/path/to/towpath/scratch
